{
  "name": "figma-agent-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "Figma plugin + local MCP bridge + design-reviewer agent. Routes around Code Connect on the Professional plan.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --filter './packages/*' --parallel dev",
    "lint": "pnpm -r --filter './packages/*' lint",
    "typecheck": "tsc -b",
    "test": "pnpm -r --filter './packages/*' test",
    "clean": "pnpm -r --filter './packages/*' clean && rm -rf node_modules",
    "start": "node packages/mcp-server/dist/index.js",
    "start:http": "node packages/mcp-server/dist/index.js --http"
  },
  "bin": {
    "figma-agent": "./packages/mcp-server/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
