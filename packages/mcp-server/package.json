{
  "name": "@figma-agent/mcp-server",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server exposing Figma read tools over stdio and HTTP transports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "figma-agent-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:nobundle": "node dist/index.js --no-bundle",
    "bundle": "node scripts/bundle.mjs",
    "publish:dry": "pnpm bundle && cd dist-pkg && npm pack --dry-run",
    "publish:public": "pnpm bundle && cd dist-pkg && npm publish --access public",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@figma-agent/relay": "workspace:*",
    "@figma-agent/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
