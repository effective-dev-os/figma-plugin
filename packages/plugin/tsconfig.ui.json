{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist-ui",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo.ui"
  },
  "include": [
    "src/ui.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx"
  ],
  "references": [
    { "path": "../shared" }
  ]
}
